---
// CadMode.astro — System Schematics 3D Hologram
---

<style>
  @keyframes holoFlicker {
    0%, 100% { opacity: 1; }
    5% { opacity: 0.8; }
    10% { opacity: 0.95; }
    15% { opacity: 0.85; }
    50% { opacity: 0.9; }
    80% { opacity: 1; }
    90% { opacity: 0.75; }
  }
  .holo-flicker {
    animation: holoFlicker 3s infinite ease-in-out;
  }
</style>

<div id="cad-stage" class="fixed inset-0 z-[5000] pointer-events-none opacity-0 flex items-center justify-center bg-[#060d14]/96 overflow-hidden" style="perspective: 1800px;">

  <!-- Terminal HUD (Bottom Left) -->
  <div id="cad-hud" class="absolute bottom-6 left-6 md:bottom-8 md:left-8 w-[calc(100vw-3rem)] md:w-72 min-h-[140px] p-4 border border-cyan-500/40 bg-[#07131f]/95 font-mono text-[10px] md:text-[11px] leading-relaxed opacity-0" style="transform: translateY(20px);">
    <div class="flex items-center gap-2 mb-3">
      <div class="w-1.5 h-1.5 bg-cyan-400 rounded-full animate-pulse"></div>
      <span class="tracking-[0.2em] text-cyan-500/70 text-[8px] md:text-[9px] uppercase">System Terminal</span>
    </div>
    <div id="hud-output" class="text-cyan-300 whitespace-pre-line"></div>
  </div>

  <!-- Instruction hint (top left) -->
  <div class="absolute top-6 left-6 md:top-8 md:left-8 font-mono text-[8px] md:text-[9px] text-cyan-500/40 tracking-[0.15em] uppercase opacity-0 hidden md:block" id="cad-hint">
    Hover layers to inspect &nbsp;·&nbsp; Move mouse to orbit
  </div>

  <!-- 3D Wrapper -->
  <div id="cad-wrapper" class="relative w-[85vw] md:w-[60vw] max-w-[780px] h-[50vh] md:h-[55vh]" style="transform-style: preserve-3d; transform-origin: center center;">

    <!-- Data Stream Particles -->
    <div id="cad-particles" class="absolute inset-0 pointer-events-none" style="transform-style: preserve-3d;">
      <div class="data-particle absolute left-[20%] top-[30%] w-1.5 h-1.5 rounded-full bg-cyan-300 shadow-[0_0_8px_#00E5FF] opacity-0"></div>
      <div class="data-particle absolute left-[50%] top-[40%] w-1.5 h-1.5 rounded-full bg-cyan-300 shadow-[0_0_8px_#00E5FF] opacity-0"></div>
      <div class="data-particle absolute left-[75%] top-[60%] w-1.5 h-1.5 rounded-full bg-[#D97757] shadow-[0_0_8px_#D97757] opacity-0"></div>
      <div class="data-particle absolute left-[35%] top-[70%] w-1.5 h-1.5 rounded-full bg-cyan-300 shadow-[0_0_8px_#00E5FF] opacity-0"></div>
      <div class="data-particle absolute left-[80%] top-[20%] w-1.5 h-1.5 rounded-full bg-[#D97757] shadow-[0_0_8px_#D97757] opacity-0"></div>
      <div class="data-particle absolute left-[45%] top-[80%] w-1.5 h-1.5 rounded-full bg-cyan-300 shadow-[0_0_8px_#00E5FF] opacity-0"></div>
      <div class="data-particle absolute left-[65%] top-[25%] w-1.5 h-1.5 rounded-full bg-cyan-300 shadow-[0_0_8px_#00E5FF] opacity-0"></div>
    </div>

    <!-- Layer 4: Foundation (Deepest) -->
    <div class="cad-layer absolute inset-0 border border-cyan-500/25 bg-[#07131f]/85 flex flex-col items-center justify-center rounded-sm pointer-events-none" style="transform-style: preserve-3d;" data-layer="4">
      <div class="absolute inset-0 opacity-[0.07]" style="background-image: linear-gradient(rgba(6,182,212,1) 1px, transparent 1px), linear-gradient(90deg, rgba(6,182,212,1) 1px, transparent 1px); background-size: 30px 30px md:background-size: 40px 40px;"></div>
      <div class="text-[8px] md:text-[9px] font-mono text-cyan-400/40 tracking-[0.3em] uppercase mb-1 md:mb-2 holo-flicker">04 / Foundation</div>
      <div class="text-lg md:text-2xl font-bold font-mono text-cyan-500/30 tracking-wider holo-flicker">Engineering Core</div>
      <div class="mt-2 md:mt-3 flex gap-2 md:gap-3 flex-wrap justify-center px-4 holo-flicker">
        <span class="text-[7px] md:text-[8px] font-mono text-cyan-500/30 border border-cyan-500/20 px-2 py-1">SYSTEM DESIGN</span>
        <span class="text-[7px] md:text-[8px] font-mono text-cyan-500/30 border border-cyan-500/20 px-2 py-1">ARCHITECTURE</span>
      </div>
      <!-- Right tag -->
      <div class="cad-tag absolute right-0 top-1/2 -translate-y-1/2 translate-x-[90%] md:translate-x-full flex items-center gap-0 opacity-0 pointer-events-none hidden md:flex">
        <div class="w-4 md:w-8 h-px bg-cyan-400/60 relative"><div class="absolute right-0 top-[-3px] w-1.5 h-1.5 bg-cyan-300 rounded-full"></div></div>
        <div class="text-[9px] md:text-[10px] text-cyan-300 font-mono bg-[#060d14] px-2 py-1.5 md:px-3 md:py-2 border border-cyan-400/40 ml-0 whitespace-nowrap holo-flicker">
          <div class="text-white font-semibold">FOUNDATION</div>
          <div class="text-cyan-500/70">Principles &amp; Patterns</div>
        </div>
      </div>
    </div>

    <!-- Layer 3: Infrastructure -->
    <div class="cad-layer absolute inset-0 border border-cyan-500/35 bg-[#091a2a]/65 backdrop-blur-[1px] flex flex-col items-center justify-center rounded-sm pointer-events-none" style="transform-style: preserve-3d;" data-layer="3">
      <div class="text-[8px] md:text-[9px] font-mono text-cyan-400/50 tracking-[0.3em] uppercase mb-1 md:mb-2 holo-flicker">03 / Infrastructure</div>
      <div class="text-lg md:text-2xl font-bold font-mono text-cyan-400/40 tracking-wider holo-flicker">Cloud &amp; Data</div>
      <div class="mt-2 md:mt-3 flex gap-2 md:gap-3 flex-wrap justify-center px-4 holo-flicker">
        <span class="text-[7px] md:text-[8px] font-mono text-cyan-400/35 border border-cyan-400/25 px-2 py-1">GCP</span>
        <span class="text-[7px] md:text-[8px] font-mono text-cyan-400/35 border border-cyan-400/25 px-2 py-1">KUBERNETES</span>
        <span class="text-[7px] md:text-[8px] font-mono text-cyan-400/35 border border-cyan-400/25 px-2 py-1">MONGODB</span>
      </div>
      <!-- Left tag -->
      <div class="cad-tag absolute left-0 top-1/3 -translate-x-[90%] md:-translate-x-full flex items-center gap-0 flex-row-reverse opacity-0 pointer-events-none hidden md:flex">
        <div class="w-4 md:w-8 h-px bg-cyan-400/60 relative"><div class="absolute left-0 top-[-3px] w-1.5 h-1.5 bg-cyan-300 rounded-full"></div></div>
        <div class="text-[9px] md:text-[10px] text-cyan-300 font-mono bg-[#060d14] px-2 py-1.5 md:px-3 md:py-2 border border-cyan-400/40 mr-0 text-right whitespace-nowrap holo-flicker">
          <div class="text-white font-semibold">SYSTEMS LAYER</div>
          <div class="text-cyan-500/70">GCS · Pub/Sub · K8s</div>
        </div>
      </div>
    </div>

    <!-- Layer 2: Logic -->
    <div class="cad-layer absolute inset-0 border border-cyan-400/45 bg-[#0b2237]/50 backdrop-blur-[2px] flex flex-col items-center justify-center rounded-sm pointer-events-none" style="transform-style: preserve-3d;" data-layer="2">
      <div class="text-[8px] md:text-[9px] font-mono text-cyan-400/60 tracking-[0.3em] uppercase mb-1 md:mb-2 holo-flicker">02 / Logic</div>
      <div class="text-lg md:text-2xl font-bold font-mono text-cyan-300/50 tracking-wider holo-flicker">API &amp; Services</div>
      <div class="mt-2 md:mt-3 flex gap-2 md:gap-3 flex-wrap justify-center px-4 holo-flicker">
        <span class="text-[7px] md:text-[8px] font-mono text-cyan-300/40 border border-cyan-300/25 px-2 py-1">JAVA 21</span>
        <span class="text-[7px] md:text-[8px] font-mono text-cyan-300/40 border border-cyan-300/25 px-2 py-1">SPRING BOOT</span>
        <span class="text-[7px] md:text-[8px] font-mono text-cyan-300/40 border border-cyan-300/25 px-2 py-1">REST</span>
      </div>
      <!-- Right tag -->
      <div class="cad-tag absolute right-0 bottom-1/3 translate-x-[90%] md:translate-x-full flex items-center gap-0 opacity-0 pointer-events-none hidden md:flex">
        <div class="w-4 md:w-8 h-px bg-cyan-400/60 relative"><div class="absolute right-0 top-[-3px] w-1.5 h-1.5 bg-cyan-300 rounded-full"></div></div>
        <div class="text-[9px] md:text-[10px] text-cyan-300 font-mono bg-[#060d14] px-2 py-1.5 md:px-3 md:py-2 border border-cyan-400/40 whitespace-nowrap holo-flicker">
          <div class="text-white font-semibold">LOGIC LAYER</div>
          <div class="text-cyan-500/70">Microservices · REST</div>
        </div>
      </div>
    </div>

    <!-- Layer 1: Presentation (Top) -->
    <div class="cad-layer absolute inset-0 border border-cyan-300/55 bg-cyan-950/20 backdrop-blur-[3px] flex flex-col items-center justify-center rounded-sm pointer-events-none" style="transform-style: preserve-3d;" data-layer="1">
      <div class="text-[8px] md:text-[9px] font-mono text-cyan-300/70 tracking-[0.3em] uppercase mb-1 md:mb-2 holo-flicker">01 / Presentation</div>
      <div class="text-lg md:text-2xl font-bold font-mono text-cyan-200/60 tracking-wider drop-shadow-[0_0_12px_rgba(6,182,212,0.4)] holo-flicker">UI / UX Layer</div>
      <div class="mt-2 md:mt-3 flex gap-2 md:gap-3 flex-wrap justify-center px-4 holo-flicker">
        <span class="text-[7px] md:text-[8px] font-mono text-cyan-200/50 border border-cyan-200/30 px-2 py-1">ANGULAR 17</span>
        <span class="text-[7px] md:text-[8px] font-mono text-cyan-200/50 border border-cyan-200/30 px-2 py-1">TAILWIND</span>
        <span class="text-[7px] md:text-[8px] font-mono text-cyan-200/50 border border-cyan-200/30 px-2 py-1">GSAP</span>
      </div>
      <!-- Left tag -->
      <div class="cad-tag absolute left-0 bottom-1/4 -translate-x-[90%] md:-translate-x-full flex items-center gap-0 flex-row-reverse opacity-0 pointer-events-none hidden md:flex">
        <div class="w-4 md:w-8 h-px bg-cyan-300/60 relative"><div class="absolute left-0 top-[-3px] w-1.5 h-1.5 bg-cyan-200 rounded-full shadow-[0_0_8px_#67e8f9]"></div></div>
        <div class="text-[9px] md:text-[10px] text-cyan-200 font-mono bg-[#060d14] px-2 py-1.5 md:px-3 md:py-2 border border-cyan-300/40 mr-0 text-right whitespace-nowrap holo-flicker">
          <div class="text-white font-semibold">PRESENTATION</div>
          <div class="text-cyan-400/70">Angular · Tailwind · GSAP</div>
        </div>
      </div>
    </div>

  </div>

  <!-- Close button -->
  <button id="cad-close" class="absolute top-4 right-4 md:top-6 md:right-6 text-cyan-400 font-mono text-[9px] md:text-[10px] uppercase tracking-[0.2em] border border-cyan-500/50 bg-[#060d14]/90 px-4 py-2 md:px-5 md:py-2.5 hover:bg-cyan-500/10 hover:border-cyan-300 transition-all pointer-events-auto opacity-0 shadow-[0_0_20px_rgba(6,182,212,0.1)]" style="transform: translateY(-20px);">
    [ ESC ] Close
  </button>

</div>

<script is:inline>
  (function() {
    let isActive = false;

    function initCadMode() {
      const gsap = window.gsap;
      const btnOpen = document.getElementById("btn-cad-mode");
      if (!gsap || !btnOpen) { setTimeout(initCadMode, 50); return; }

      const cadStage   = document.getElementById("cad-stage");
      const btnClose   = document.getElementById("cad-close");
      const cadWrapper = document.getElementById("cad-wrapper");
      const mainContent = document.getElementById("main-content");
      const hud        = document.getElementById("cad-hud");
      const hint       = document.getElementById("cad-hint");
      const hudOutput  = document.getElementById("hud-output");
      const layers     = document.querySelectorAll(".cad-layer");
      const tags       = document.querySelectorAll(".cad-tag");
      const dataParticles = document.querySelectorAll(".data-particle");

      if (!cadStage || !mainContent) return;

      let typeInterval;
      // Typewriter — plain text, no HTML tags, uses \n for line breaks
      function typeToHud(lines) {
        if (typeInterval) clearInterval(typeInterval);
        hudOutput.textContent = "";
        const full = lines.join("\n");
        let i = 0;
        typeInterval = setInterval(() => {
          if (i < full.length) { hudOutput.textContent += full[i]; i++; }
          else clearInterval(typeInterval);
        }, 12);
      }

      function highlightLayer(layer, id) {
        gsap.to(layer, { backgroundColor: "rgba(6,182,212,0.15)", borderColor: "rgba(34,211,238,0.9)", duration: 0.25 });
        if (id === "1") typeToHud(["> PRESENTATION LAYER", "", "Status: ONLINE", "Stack: Angular 17, Tailwind CSS,", "       GSAP Motion"]);
        else if (id === "2") typeToHud(["> LOGIC LAYER", "", "Status: ONLINE", "Stack: Java 21, Spring Boot,", "       REST APIs, Microservices"]);
        else if (id === "3") typeToHud(["> INFRASTRUCTURE LAYER", "", "Status: ONLINE", "Stack: GCP (GCS, Pub/Sub),", "       MongoDB, Kubernetes"]);
        else typeToHud(["> FOUNDATION LAYER", "", "Status: ONLINE", "Principles: System Design,", "            Clean Architecture"]);
      }

      function resetLayer(layer) {
        gsap.to(layer, { clearProps: "backgroundColor,borderColor", duration: 0.35 });
      }

      layers.forEach(layer => {
        layer.addEventListener("mouseenter", () => {
          if (!isActive) return;
          highlightLayer(layer, layer.getAttribute("data-layer"));
        });
        layer.addEventListener("mouseleave", () => {
          if (!isActive) return;
          resetLayer(layer);
        });
        // Mobile tap support
        layer.addEventListener("touchstart", () => {
          if (!isActive) return;
          layers.forEach(l => resetLayer(l)); // reset others
          highlightLayer(layer, layer.getAttribute("data-layer"));
        }, { passive: true });
      });

      const onParallax = (e) => {
        if (!isActive) return;
        
        let clientX = e.clientX;
        let clientY = e.clientY;
        
        // Support touch events
        if (e.touches && e.touches.length > 0) {
          clientX = e.touches[0].clientX;
          clientY = e.touches[0].clientY;
        }

        const x = (clientX / window.innerWidth  - 0.5) * 15;
        const y = (clientY / window.innerHeight - 0.5) * -15;
        
        // Less rotation on smaller screens to keep things visible
        const isMobile = window.innerWidth < 768;
        const rotateXBase = isMobile ? 45 : 58;

        gsap.to(cadWrapper, { rotateY: x, rotateX: rotateXBase + y, duration: 0.6, ease: "power1.out", overwrite: "auto" });
      };

      let particleAnim;
      const startParticles = (zSpacing) => {
        if (particleAnim) particleAnim.kill();
        const topZ = 3 * zSpacing + 80; // shoot slightly past the top layer
        gsap.set(dataParticles, { z: -20, opacity: 0 });
        
        particleAnim = gsap.to(dataParticles, {
          z: topZ,
          duration: 1.5,
          ease: "none",
          stagger: { each: 0.2, repeat: -1 },
          keyframes: [
            { opacity: 1, duration: 0.3, ease: "power1.inOut" },
            { opacity: 1, duration: 0.9 },
            { opacity: 0, duration: 0.3, ease: "power1.inOut" }
          ]
        });
      };

      btnOpen.addEventListener("click", (e) => {
        e.preventDefault();
        if (isActive) return;
        isActive = true;
        hudOutput.textContent = "> Initialising schematic...";

        const isMobile = window.innerWidth < 768;
        const rotateXEnd = isMobile ? 45 : 58;
        const rotateZEnd = isMobile ? -30 : -42;
        const zSpacing = isMobile ? 80 : 140;

        // Task 1: Boot-up glitch effect on mainContent
        gsap.to(mainContent, {
          filter: "invert(1) hue-rotate(90deg) contrast(150%)",
          duration: 0.05,
          yoyo: true,
          repeat: 3,
          onComplete: () => {
            gsap.set(mainContent, { clearProps: "filter" });
            
            // Standard launch timeline
            const tl = gsap.timeline();
            tl.to(mainContent, { opacity: 0, scale: 0.97, duration: 0.5, ease: "power2.inOut" })
              .set(cadStage,   { opacity: 1, pointerEvents: "auto" }, "-=0.2")
              .set(cadWrapper, { rotateX: 0, rotateZ: 0, rotateY: 0, scale: 1 })
              .set(layers,     { z: 0, pointerEvents: "auto" })
              .to(cadWrapper,  { rotateX: rotateXEnd, rotateZ: rotateZEnd, scale: 1, duration: 1.4, ease: "expo.inOut" }, "-=0.1")
              .to(layers,      { z: (i) => i * zSpacing, duration: 1.4, ease: "expo.out" }, "-=0.9")
              .to(tags,        { opacity: 1, x: (i) => (i % 2 === 0 ? 12 : -12), stagger: 0.08, duration: 0.6, ease: "power2.out" }, "-=0.8")
              .to([btnClose, hud, hint], { opacity: 1, y: 0, duration: 0.4, stagger: 0.08 }, "-=0.4");
              
            // Task 2: Live Data Stream
            startParticles(zSpacing);

            document.addEventListener("mousemove", onParallax);
            document.addEventListener("touchmove", onParallax, { passive: true });
          }
        });
      });

      const closeCAD = () => {
        if (!isActive) return;
        isActive = false;
        document.removeEventListener("mousemove", onParallax);
        document.removeEventListener("touchmove", onParallax);
        
        if (particleAnim) {
          particleAnim.kill();
          particleAnim = null;
        }
        
        const tl = gsap.timeline();
        tl.to([btnClose, hud, hint], { opacity: 0, y: -10, duration: 0.25 })
          .to(tags,        { opacity: 0, x: 0, duration: 0.25 }, "-=0.25")
          .to(layers,      { z: 0, duration: 0.9, ease: "expo.inOut" }, "-=0.1")
          .to(cadWrapper,  { rotateX: 0, rotateZ: 0, rotateY: 0, duration: 1.0, ease: "expo.inOut" }, "-=0.9")
          .set(cadStage,   { opacity: 0, pointerEvents: "none" })
          .set(layers,     { pointerEvents: "none" })
          .to(mainContent, { opacity: 1, scale: 1, duration: 0.5, ease: "power2.out" });
      };

      btnClose.addEventListener("click", closeCAD);
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && isActive) closeCAD(); });
    }

    window.addEventListener("load", initCadMode);
    if (document.readyState === "complete") initCadMode();
  })();
</script>
