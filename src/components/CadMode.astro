---
// CadMode.astro — WebGL True 3D Holographic System (Vertical Exploded Blueprint)
---

<div id="cad-stage" class="fixed inset-0 z-[5000] pointer-events-none opacity-0 overflow-hidden hidden bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-[#1A1512] via-[#0A0A0A] to-black">
  
  <!-- 400vh Scrolling Container for Lenis & GSAP ScrollTrigger (Unused, leaving for structure) -->
  <div id="cad-scroll-container" class="w-full h-full"></div>

  <!-- Fixed WebGL & UI Layer -->
  <div class="fixed inset-0 pointer-events-none flex items-center justify-center">
    <canvas id="webgl-canvas" class="absolute inset-0 w-full h-full outline-none pointer-events-auto"></canvas>

    <!-- Terminal HUD -->
    <div id="cad-hud" class="absolute bottom-6 left-6 md:bottom-10 md:left-10 w-[calc(100vw-3rem)] md:w-80 p-5 border border-[#FFDF00]/40 bg-[#0a0a0a]/90 font-mono text-[10px] md:text-xs leading-relaxed opacity-0 pointer-events-none shadow-[0_0_15px_rgba(255,223,0,0.15)]" style="transform: translateY(20px);">
      <div class="flex items-center gap-2 mb-3">
        <div class="w-2 h-2 bg-[#FFDF00] rounded-full animate-pulse shadow-[0_0_8px_#FFDF00]"></div>
        <span class="tracking-[0.2em] text-[#FFDF00]/80 text-[9px] uppercase">JARVIS System Terminal</span>
      </div>
      <div id="hud-output" class="text-[#FFDF00] whitespace-pre-line"></div>
    </div>

    <!-- Scroll Hint -->
    <div class="absolute top-6 left-6 md:top-8 md:left-8 flex flex-col gap-2 opacity-0 pointer-events-none" id="cad-hint">
      <div class="font-mono text-[8px] md:text-[9px] text-[#FFDF00]/50 tracking-[0.2em] uppercase">
        Drag to Orbit &nbsp;·&nbsp; Hover to Inspect
      </div>
    </div>

    <!-- Close button -->
    <button id="cad-close" class="absolute top-4 right-4 md:top-8 md:right-8 text-[#FF4500] font-mono text-[10px] md:text-xs uppercase tracking-[0.2em] border border-[#FF4500]/50 bg-[#0a0a0a]/90 px-5 py-2.5 hover:bg-[#FF4500]/20 hover:border-[#FF4500] transition-all pointer-events-auto opacity-0 shadow-[0_0_20px_rgba(255,69,0,0.2)]" style="transform: translateY(-20px);">
      [ ESC ] Close Schematic
    </button>
  </div>
</div>

<script type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
      "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
    }
  }
</script>

<script type="module" is:inline>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
  import { BokehPass } from 'three/addons/postprocessing/BokehPass.js';
  import { FilmPass } from 'three/addons/postprocessing/FilmPass.js';
  import { ShaderPass } from 'three/addons/postprocessing/ShaderPass.js';
  import { RGBShiftShader } from 'three/addons/shaders/RGBShiftShader.js';

  (function() {
    let isActive = false;
    let scene, camera, renderer, composer, controls, raycaster, mouse;
    let coreLight, floorLight;
    let animationId;
    let isExploded = false;
    let hoveredObj = null;

    // The 5 Layers
    const layerMeshes = [];
    const shaders = [];

    // Raycaster dynamic focal point
    let focusPoint = new THREE.Vector3(0, 0, 0);

    const getShaderMaterial = () => new THREE.ShaderMaterial({
      uniforms: {
        uTime: { value: 0 },
        uColorYellow: { value: new THREE.Color(0xFFDF00) },
        uColorOrange: { value: new THREE.Color(0xFF4500) },
        uHighlight: { value: 0.0 }, 
        uOpacity: { value: 1.0 }    
      },
      vertexShader: `
        varying vec3 vPos;
        void main() {
          vPos = position;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        uniform float uTime;
        uniform vec3 uColorYellow;
        uniform vec3 uColorOrange;
        uniform float uHighlight;
        uniform float uOpacity;
        varying vec3 vPos;

        void main() {
          // Wide, continuous sweeping diagonal wave
          float wave = sin(vPos.x * 0.4 + vPos.y * 0.4 - uTime * 2.0);
          float pulse = smoothstep(0.2, 1.0, wave); 

          vec3 baseColor = mix(uColorYellow, uColorOrange, uHighlight);
          vec3 finalColor = baseColor + (uColorOrange * pulse * 2.0);
          
          // Boosted base alpha to 0.25 for sharp architectural presence
          float alpha = (mix(0.25, 0.8, uHighlight) + pulse) * uOpacity;
          gl_FragColor = vec4(finalColor, alpha);
        }
      `,
      transparent: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    });

    function initWebGL() {
      const canvas = document.getElementById("webgl-canvas");
      if (!canvas) return;

      scene = new THREE.Scene();

      camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.position.set(0, 0, 15);

      renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      // 4K Floor & Lighting Setup
      const grid = new THREE.GridHelper(50, 50, 0x333333, 0x111111);
      grid.position.y = -18; 
      scene.add(grid);

      coreLight = new THREE.PointLight(0xFFDF00, 2, 100); 
      scene.add(coreLight);

      floorLight = new THREE.PointLight(0xFF4500, 0.8, 50);
      floorLight.position.set(0, -12, 0);
      scene.add(floorLight);

      // Post-Processing
      const renderScene = new RenderPass(scene, camera);
      const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.5, 0.4, 0.85);
      bloomPass.threshold = 0.9; 
      bloomPass.strength = 0.4;
      bloomPass.radius = 0.4;

      const bokehPass = new BokehPass(scene, camera, {
        focus: 15.0,     
        aperture: 0.002, 
        maxblur: 0.005,  
        width: window.innerWidth,
        height: window.innerHeight
      });

      const filmPass = new FilmPass(0.35, 0, 0, false); 
      const rgbShift = new ShaderPass(RGBShiftShader);
      rgbShift.uniforms['amount'].value = 0.0015;

      composer = new EffectComposer(renderer);
      composer.addPass(renderScene);
      composer.addPass(bloomPass);
      composer.addPass(bokehPass);
      composer.addPass(filmPass);
      composer.addPass(rgbShift);

      controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.05;
      controls.autoRotate = false; 
      controls.enablePan = false; 
      controls.enabled = false;

      raycaster = new THREE.Raycaster();
      mouse = new THREE.Vector2();

      // Geometries: 5 Layer Discs (EdgesGeometry for clean lines)
      const layersData = [
        { id: "1", name: "PRESENTATION (UI)", desc: "Angular 17, Tailwind CSS\nJARVIS Holographic Interface" },
        { id: "2", name: "API GATEWAY", desc: "Spring Cloud Gateway\nRate Limiting & Auth" },
        { id: "3", name: "MICROSERVICES", desc: "Java 21, Spring Boot\nEvent-Driven Architecture" },
        { id: "4", name: "INFRASTRUCTURE", desc: "GCP (GCS, Pub/Sub)\nKubernetes Cluster" },
        { id: "5", name: "DATA LAYER", desc: "MongoDB Atlas Clusters\nDistributed Storage" }
      ];

      const targetYs = [12, 6, 0, -6, -12];

      const baseGeo = new THREE.RingGeometry(1.5, 6, 64, 8);
      const edgesGeo = new THREE.EdgesGeometry(baseGeo);

      layersData.forEach((data, index) => {
        const mat = getShaderMaterial();
        shaders.push(mat);
        
        const mesh = new THREE.LineSegments(edgesGeo, mat);
        mesh.rotation.x = -Math.PI / 2; // Lie flat
        mesh.position.set(0, 0, 0); // Initially dense core
        mesh.userData = { ...data, targetY: targetYs[index] };
        
        layerMeshes.push(mesh);
        scene.add(mesh);
      });

      // The Vertical Data Bus (Spinal Cord)
      const busGeo = new THREE.CylinderGeometry(0.02, 0.02, 24, 8);
      const busMat = new THREE.MeshBasicMaterial({ color: 0xFF4500, transparent: true, opacity: 0 });
      window.dataBus = new THREE.Mesh(busGeo, busMat);
      window.dataBus.userData = { baseOpacity: 0 }; // Proxied for GSAP
      scene.add(window.dataBus);

      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
        composer.setSize(window.innerWidth, window.innerHeight);
        bokehPass.uniforms['aspect'].value = window.innerWidth / window.innerHeight;
      });

      canvas.addEventListener('mousemove', (event) => {
        if (!isActive || !isExploded) return;
        mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
        mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
      });
      
      canvas.addEventListener('touchstart', (event) => {
        if (!isActive || !isExploded || event.touches.length === 0) return;
        mouse.x = (event.touches[0].clientX / window.innerWidth) * 2 - 1;
        mouse.y = -(event.touches[0].clientY / window.innerHeight) * 2 + 1;
      }, {passive: true});

      const clock = new THREE.Clock();

      const animate = () => {
        animationId = requestAnimationFrame(animate);

        // PRODUCTION OPTIMIZATION: Halt expensive WebGL rendering when modal is hidden
        const stage = document.getElementById("cad-stage");
        if (stage && stage.classList.contains("hidden")) return;

        const time = clock.getElapsedTime();
        
        // Update GLSL Shader time
        shaders.forEach(mat => {
          if (mat.uniforms && mat.uniforms.uTime) mat.uniforms.uTime.value = time;
        });

        // Ambient rotation for the discs
        layerMeshes.forEach((mesh, i) => {
           mesh.rotation.z += (i % 2 === 0 ? 0.002 : -0.002); // Rotated flat, so Z is yaw
        });

        // Throbbing Data Bus (Sine wave mapped to GSAP baseOpacity)
        if (window.dataBus) {
           const throb = (Math.sin(time * 5.0) * 0.5 + 0.5) * 0.4;
           window.dataBus.material.opacity = window.dataBus.userData.baseOpacity + (window.dataBus.userData.baseOpacity > 0 ? throb : 0);
        }

        controls.update();
        
        // Dynamically calculate focus distance to the tracked focal point
        bokehPass.uniforms['focus'].value = camera.position.distanceTo(focusPoint);

        // Raycasting Logic
        if (isActive && isExploded) {
          raycaster.setFromCamera(mouse, camera);
          const intersects = raycaster.intersectObjects(layerMeshes, false);

          if (intersects.length > 0) {
            let targetGroup = intersects[0].object;

            if (hoveredObj !== targetGroup) {
              hoveredObj = targetGroup;
              document.body.style.cursor = 'crosshair';
              gsap.to(coreLight, { intensity: 8, duration: 0.2 });

              // Snap physical lens focus to the specific Y-level of the hovered layer
              gsap.to(focusPoint, { y: targetGroup.position.y, duration: 0.4, ease: "power2.out" });

              layerMeshes.forEach(m => gsap.to(m.material.uniforms.uHighlight, { value: 0.0, duration: 0.2 }));
              gsap.to(targetGroup.material.uniforms.uHighlight, { value: 1.0, duration: 0.2 });
              
              updateHUD(targetGroup.userData);
            }
          } else {
            if (hoveredObj !== null) {
              hoveredObj = null;
              document.body.style.cursor = 'default';
              gsap.to(coreLight, { intensity: 2, duration: 0.4 });
              
              // Reset lens focus to the center of the stack
              gsap.to(focusPoint, { y: 0, duration: 0.8, ease: "power2.out" });

              layerMeshes.forEach(m => gsap.to(m.material.uniforms.uHighlight, { value: 0.0, duration: 0.4 }));
            }
          }
        }

        composer.render();
      };
      animate();
    }

    let currentHudId = null;
    function updateHUD(data) {
      if (currentHudId === data.id) return;
      currentHudId = data.id;
      const hudOutput = document.getElementById("hud-output");
      hudOutput.textContent = `> TARGET: ${data.name}\n\nStatus: ONLINE\nStack: ${data.desc}`;
    }

    function setupUI() {
      const gsap = window.gsap;
      
      const btnOpen = document.getElementById("btn-cad-mode");
      const btnClose = document.getElementById("cad-close");
      const cadStage = document.getElementById("cad-stage");
      const mainContent = document.getElementById("main-content");
      const hud = document.getElementById("cad-hud");
      const hint = document.getElementById("cad-hint");
      const hudOutput = document.getElementById("hud-output");

      // Update the hint text since scroll is removed
      if (hint) {
        hint.innerHTML = `
          <div class="font-mono text-[8px] md:text-[9px] text-[#FFDF00]/50 tracking-[0.2em] uppercase">
            Drag to Orbit &nbsp;·&nbsp; Hover to Inspect
          </div>
        `;
      }

      if (!btnOpen || !cadStage || !mainContent || !gsap) {
        setTimeout(setupUI, 100);
        return;
      }

      initWebGL();

      btnOpen.addEventListener("click", (e) => {
        e.preventDefault();
        if (isActive) return;
        isActive = true;
        hudOutput.textContent = "> Initializing JARVIS architecture...";
        currentHudId = null;

        cadStage.classList.remove("hidden");
        cadStage.classList.add("block");

        const isMobile = window.innerWidth < 768;

        gsap.to(mainContent, {
          filter: "invert(1) hue-rotate(90deg) contrast(150%)",
          duration: 0.05,
          yoyo: true,
          repeat: 3,
          onComplete: () => {
            gsap.set(mainContent, { clearProps: "filter" });
            
            const tlInit = gsap.timeline();
            tlInit.to(mainContent, { opacity: 0, scale: 0.95, duration: 0.5, ease: "power2.inOut" })
              .to(cadStage, { opacity: 1, pointerEvents: "auto", duration: 0.5 }, "-=0.2")
              .to([btnClose, hud, hint], { opacity: 1, y: 0, duration: 0.5, stagger: 0.1 }, "+=0.2");

            controls.enabled = true;
            
            // Fixed isometric safe distance
            gsap.to(camera.position, {
              x: isMobile ? 15 : 20,
              y: isMobile ? 10 : 15,
              z: isMobile ? 35 : 25,
              duration: 2.5,
              ease: "expo.inOut",
              onComplete: () => { isExploded = true; }
            });
            gsap.to(controls.target, { x: 0, y: 0, z: 0, duration: 2.5, ease: "expo.inOut" });

            // Automatically dissect the 5 compressed rings
            layerMeshes.forEach((mesh, index) => {
               gsap.to(mesh.position, { 
                 y: mesh.userData.targetY, 
                 duration: 2.5, 
                 ease: "expo.out",
                 delay: 0.2 + (index * 0.1) // slight stagger
               });
            });

            // Ignite the vertical Data Bus
            if (window.dataBus) {
              gsap.to(window.dataBus.userData, { baseOpacity: 0.4, duration: 2.5, ease: "expo.inOut" });
            }
          }
        });
      });

      const closeCAD = () => {
        if (!isActive) return;
        isActive = false;
        isExploded = false;
        controls.enabled = false;
        document.body.style.cursor = 'default';

        const tl = gsap.timeline();
        tl.to([btnClose, hud, hint], { opacity: 0, y: -10, duration: 0.3 })
          .set(cadStage, { pointerEvents: "none" })
          .to(cadStage, { opacity: 0, duration: 0.5 }, "+=0.5")
          .to(mainContent, { opacity: 1, scale: 1, duration: 0.5, ease: "power2.out" }, "-=0.2")
          .set(cadStage, { className: "+=hidden" });

        gsap.to(camera.position, { x: 0, y: 0, z: 15, duration: 1.5, ease: "expo.inOut" });
        gsap.to(focusPoint, { y: 0, duration: 1.5 });
        layerMeshes.forEach(mesh => gsap.to(mesh.position, { x: 0, y: 0, z: 0, duration: 1.5, ease: "expo.inOut" }));

        if (window.dataBus) {
          gsap.to(window.dataBus.userData, { baseOpacity: 0, duration: 1.5, ease: "expo.inOut" });
        }
      };

      btnClose.addEventListener("click", closeCAD);
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && isActive) closeCAD(); });
    }

    window.addEventListener("load", setupUI);
    if (document.readyState === "complete") setupUI();
  })();
</script>
