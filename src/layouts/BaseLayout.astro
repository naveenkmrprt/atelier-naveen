---
import "../styles/global.css";
import CustomCursor from "../components/CustomCursor.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Naveen Kumar — Senior Full-Stack Engineer",
  description = "Portfolio of Naveen Kumar, a Senior Full-Stack Engineer specializing in scalable architecture.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- GSAP CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" is:inline></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" is:inline></script>
  </head>
  <body class="bg-base text-cream font-sans antialiased overflow-x-hidden">
    <CustomCursor />
    <slot />
  </body>
</html>
